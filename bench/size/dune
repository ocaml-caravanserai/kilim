; The size budget (docs/budgets.md): the gzip size of the counter of bench/size
; and of the todo, components and search examples in the release profile, in
; the two builds, and the check of the generated code of the counter, with the
; control program (control.ml) that uses each binding. `make size` and
; `make budgets` run it.

(executables
 (names counter control)
 (modes js wasm)
 (libraries
  kilim
  kilim.browser
  kilim.web
  kilim.router
  kilim.router.browser
  kilim.http
  kilim.http.browser))

(rule
 (alias size)
 (enabled_if
  (= %{profile} release))
 (deps
  size.mjs
  budget
  counter.bc.js
  counter.bc.wasm.js
  (glob_files counter.bc.wasm.assets/*.wasm)
  control.bc.js
  control.bc.wasm.js
  (glob_files control.bc.wasm.assets/*.wasm)
  ../../examples/todo/main.bc.js
  ../../examples/todo/main.bc.wasm.js
  (glob_files ../../examples/todo/main.bc.wasm.assets/*.wasm)
  ../../examples/components/main.bc.js
  ../../examples/components/main.bc.wasm.js
  (glob_files ../../examples/components/main.bc.wasm.assets/*.wasm)
  ../../examples/search/main.bc.js
  ../../examples/search/main.bc.wasm.js
  (glob_files ../../examples/search/main.bc.wasm.assets/*.wasm))
 (action
  (run
   node
   size.mjs
   budget
   --control
   control.bc.js
   control.bc.wasm.js
   control.bc.wasm.assets
   counter
   counter.bc.js
   counter.bc.wasm.js
   counter.bc.wasm.assets
   example-todo
   ../../examples/todo/main.bc.js
   ../../examples/todo/main.bc.wasm.js
   ../../examples/todo/main.bc.wasm.assets
   example-components
   ../../examples/components/main.bc.js
   ../../examples/components/main.bc.wasm.js
   ../../examples/components/main.bc.wasm.assets
   example-search
   ../../examples/search/main.bc.js
   ../../examples/search/main.bc.wasm.js
   ../../examples/search/main.bc.wasm.assets)))
