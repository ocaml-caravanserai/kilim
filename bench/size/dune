; The size budget (docs/budgets.md): the gzip size of the counter of bench/size
; and of the todo example in the release profile, in the two builds, and the
; check of the generated code of the counter. `make size` and `make budgets`
; run it.

(executable
 (name counter)
 (modes js wasm)
 (libraries kilim kilim.browser))

(rule
 (alias size)
 (enabled_if
  (= %{profile} release))
 (deps
  size.mjs
  budget
  counter.bc.js
  counter.bc.wasm.js
  (glob_files counter.bc.wasm.assets/*.wasm)
  ../../examples/todo/main.bc.js
  ../../examples/todo/main.bc.wasm.js
  (glob_files ../../examples/todo/main.bc.wasm.assets/*.wasm))
 (action
  (run
   node
   size.mjs
   budget
   counter
   counter.bc.js
   counter.bc.wasm.js
   counter.bc.wasm.assets
   example-todo
   ../../examples/todo/main.bc.js
   ../../examples/todo/main.bc.wasm.js
   ../../examples/todo/main.bc.wasm.assets)))
