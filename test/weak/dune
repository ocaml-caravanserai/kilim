; The weak tests (weak.ml, weak_fut.ml for Async.of_fut, and weak_router.ml
; for kilim.router.browser) in the js_of_ocaml and the wasm_of_ocaml builds,
; on node with --expose-gc. The native weak tests are in test/turn
; (test_component.ml and test_leak.ml), test/core (test_async.ml) and
; test/router.

(executable
 (name weak)
 (modules weak)
 (modes js wasm)
 (libraries kilim kilim.testing brr))

(executable
 (name weak_fut)
 (modules weak_fut)
 (modes js wasm)
 (libraries kilim kilim.testing kilim.browser brr))

(rule
 (alias runtest)
 (deps weak.bc.js)
 (action
  (run node --expose-gc weak.bc.js)))

(rule
 (alias runtest)
 (deps
  weak.bc.wasm.js
  (glob_files weak.bc.wasm.assets/*))
 (action
  (run node --expose-gc weak.bc.wasm.js)))

(rule
 (alias runtest)
 (deps weak_fut.bc.js)
 (action
  (run node --expose-gc weak_fut.bc.js)))

(rule
 (alias runtest)
 (deps
  weak_fut.bc.wasm.js
  (glob_files weak_fut.bc.wasm.assets/*))
 (action
  (run node --expose-gc weak_fut.bc.wasm.js)))

; weak_router: the popstate listener of kilim.router.browser, with a JS shim
; of location, history and the window listeners.

(executable
 (name weak_router)
 (modules weak_router)
 (modes js wasm)
 (libraries kilim kilim.testing kilim.router kilim.router.browser brr))

(rule
 (alias runtest)
 (deps weak_router.bc.js)
 (action
  (run node --expose-gc weak_router.bc.js)))

(rule
 (alias runtest)
 (deps
  weak_router.bc.wasm.js
  (glob_files weak_router.bc.wasm.assets/*))
 (action
  (run node --expose-gc weak_router.bc.wasm.js)))
