; The loader tests in a real headless Chrome (docs/design.html, "The loader").
; run.mjs makes the pages with `kilim page` and serves them with the builds of
; app_a and app_b. It drives Chrome through the browser interface of test/dom
; (browser.mjs, chrome.mjs). With no Chrome, it writes "SKIP: no Chrome", but
; CI sets KILIM_REQUIRE_CHROME=1 and fails.

(executables
 (names app_a app_b)
 (modes js wasm)
 (libraries kilim kilim.browser brr))

; The dune rule of docs/loader.md, with the base /rule/: the scenario "rule"
; serves its page.

(rule
 (targets index.html)
 (deps
  page.html
  app_a.bc.js
  app_a.bc.wasm.js
  (glob_files app_a.bc.wasm.assets/*))
 (action
  (run
   %{bin:kilim}
   page
   --template
   page.html
   --base
   /rule/
   --js
   app_a.bc.js
   --wasm
   app_a.bc.wasm.js
   -o
   index.html)))

(rule
 (alias runtest)
 (enabled_if
  (<> %{profile} release))
 (deps
  run.mjs
  ../dom/browser.mjs
  ../dom/chrome.mjs
  %{bin:kilim}
  index.html
  app_a.bc.js
  app_a.bc.wasm.js
  (glob_files app_a.bc.wasm.assets/*)
  app_b.bc.js
  app_b.bc.wasm.js
  (glob_files app_b.bc.wasm.assets/*)
  (env_var KILIM_CHROME)
  (env_var KILIM_REQUIRE_CHROME))
 (action
  (run node run.mjs --kilim %{bin:kilim} --profile dev)))

; The inline page in a Chrome with no JIT, thus with no WebAssembly: the
; js_of_ocaml build starts.

(rule
 (alias runtest)
 (enabled_if
  (<> %{profile} release))
 (deps
  run.mjs
  ../dom/browser.mjs
  ../dom/chrome.mjs
  %{bin:kilim}
  app_a.bc.js
  app_a.bc.wasm.js
  (glob_files app_a.bc.wasm.assets/*)
  (env_var KILIM_CHROME)
  (env_var KILIM_REQUIRE_CHROME))
 (action
  (run
   node
   run.mjs
   --kilim
   %{bin:kilim}
   --profile
   dev
   --only
   no-wasm-real
   --no-wasm)))

; The release files (`make test-release`): `kilim dist` on the release builds,
; with content names and immutable files.

(rule
 (alias runtest)
 (enabled_if
  (= %{profile} release))
 (deps
  run.mjs
  ../dom/browser.mjs
  ../dom/chrome.mjs
  %{bin:kilim}
  app_a.bc.js
  app_a.bc.wasm.js
  (glob_files app_a.bc.wasm.assets/*)
  app_b.bc.js
  app_b.bc.wasm.js
  (glob_files app_b.bc.wasm.assets/*)
  (env_var KILIM_CHROME)
  (env_var KILIM_REQUIRE_CHROME))
 (action
  (run node run.mjs --kilim %{bin:kilim} --profile release)))

; The hand mutants of the loader text (`make mutate-loader`): each mutant of
; mutants.txt must fail its scenarios. The rule of each profile tests the
; mutants of that profile.

(rule
 (alias mutants)
 (enabled_if
  (<> %{profile} release))
 (deps
  mutate.mjs
  mutants.txt
  run.mjs
  ../dom/browser.mjs
  ../dom/chrome.mjs
  %{bin:kilim}
  app_a.bc.js
  app_a.bc.wasm.js
  (glob_files app_a.bc.wasm.assets/*)
  app_b.bc.js
  app_b.bc.wasm.js
  (glob_files app_b.bc.wasm.assets/*)
  (env_var KILIM_CHROME)
  (env_var KILIM_REQUIRE_CHROME))
 (action
  (run node mutate.mjs --kilim %{bin:kilim} --profile dev)))

(rule
 (alias mutants)
 (enabled_if
  (= %{profile} release))
 (deps
  mutate.mjs
