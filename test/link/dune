; The link check of design section 13: a program that uses each module of
; kilim must link none of these units (each one links CamlinternalFormat, or
; is a part of Printf). The bytecode build lists the linked units exactly.

(executable
 (name link_check)
 (modules link_check)
 (modes byte)
 (libraries kilim))

(rule
 (alias runtest)
 (action
  (system
   "if ocamlobjinfo %{dep:link_check.bc} | grep -E \"compilation unit .(CamlinternalFormat|Stdlib__(Printf|Format|Scanf|Hashtbl|Random|Fun|Printexc)|Str)'\"; then echo 'kilim links a banned unit (design section 13)'; exit 1; fi")))

; The same check for kilim.browser. Brr already links Printf, thus:
; - Check 1: browser_check links no banned unit that brr_only (the modules of
;   Brr that kilim.browser uses) does not link.
; - Check 2: no unit of kilim_browser.cma imports a banned interface: thus
;   kilim.browser itself uses no banned module.
; -no-check-prims: the bytecode build links Brr, whose primitives exist only in
; js_of_ocaml and wasm_of_ocaml. The programs never run.

(executables
 (names browser_check brr_only)
 (modules browser_check brr_only)
 (modes byte)
 (link_flags (-no-check-prims))
 (libraries kilim kilim.browser brr))

(rule
 (alias runtest)
 (action
  (system
   "banned=\"compilation unit .(CamlinternalFormat|Stdlib__(Printf|Format|Scanf|Hashtbl|Random|Fun|Printexc)|Str)'\"; brr=$(ocamlobjinfo %{dep:brr_only.bc} | grep -E \"$banned\"); test -n \"$brr\" || { echo 'brr_only links no banned unit: the check is not valid'; exit 1; }; if ocamlobjinfo %{dep:browser_check.bc} | grep -E \"$banned\" | grep -vxF \"$brr\"; then echo 'kilim.browser links a banned unit (design section 13)'; exit 1; fi")))

(rule
 (alias runtest)
 (action
  (system
   "if ocamlobjinfo %{dep:../../src/browser/kilim_browser.cma} | grep -E \"\t(CamlinternalFormat|Stdlib__(Printf|Format|Scanf|Hashtbl|Random|Fun|Printexc)|Str)$\"; then echo 'kilim.browser imports a banned interface (design section 13)'; exit 1; fi")))

; The same two checks for kilim.web: web_check uses each module of kilim.web.

(executables
 (names web_check web_one)
 (modules web_check web_one)
 (modes byte)
 (link_flags (-no-check-prims))
 (libraries kilim.web brr))

(rule
 (alias runtest)
 (action
  (system
   "banned=\"compilation unit .(CamlinternalFormat|Stdlib__(Printf|Format|Scanf|Hashtbl|Random|Fun|Printexc)|Str)'\"; brr=$(ocamlobjinfo %{dep:brr_only.bc} | grep -E \"$banned\"); test -n \"$brr\" || { echo 'brr_only links no banned unit: the check is not valid'; exit 1; }; if ocamlobjinfo %{dep:web_check.bc} | grep -E \"$banned\" | grep -vxF \"$brr\"; then echo 'kilim.web links a banned unit (design section 13)'; exit 1; fi")))

(rule
 (alias runtest)
 (action
  (system
   "if ocamlobjinfo %{dep:../../src/web/kilim_web.cma} | grep -E \"\t(CamlinternalFormat|Stdlib__(Printf|Format|Scanf|Hashtbl|Random|Fun|Printexc)|Str)$\"; then echo 'kilim.web imports a banned interface (design section 13)'; exit 1; fi")))

; kilim.web has no main module: a program that uses only Microtask links the
; unit Kilim_web__Microtask and no other unit of kilim.web. web_check is the
; positive control: it links the five units.

(rule
 (alias runtest)
 (action
  (system
   "units() { ocamlobjinfo \"$1\" | grep -cE 'compilation unit .Kilim_web__'; }; test \"$(units %{dep:web_check.bc})\" = 5 || { echo 'web_check does not link the 5 units of kilim.web: the check is not valid'; exit 1; }; test \"$(units %{dep:web_one.bc})\" = 1 || { echo 'a program that uses one module of kilim.web links other units (design section 13)'; exit 1; }")))

; The checks of kilim.router (as kilim: no banned unit) and of
; kilim.router.browser (as kilim.browser: no banned unit that brr_only does not
; link, and no banned interface in its units).

(executables
 (names router_check)
 (modules router_check)
 (modes byte)
 (libraries kilim kilim.router))

(rule
 (alias runtest)
 (action
  (system
   "if ocamlobjinfo %{dep:router_check.bc} | grep -E \"compilation unit .(CamlinternalFormat|Stdlib__(Printf|Format|Scanf|Hashtbl|Random|Fun|Printexc)|Str)'\"; then echo 'kilim.router links a banned unit (design section 13)'; exit 1; fi")))

(executables
 (names router_browser_check)
 (modules router_browser_check)
 (modes byte)
 (link_flags (-no-check-prims))
 (libraries kilim.router.browser brr))

(rule
 (alias runtest)
 (action
  (system
   "banned=\"compilation unit .(CamlinternalFormat|Stdlib__(Printf|Format|Scanf|Hashtbl|Random|Fun|Printexc)|Str)'\"; brr=$(ocamlobjinfo %{dep:brr_only.bc} | grep -E \"$banned\"); test -n \"$brr\" || { echo 'brr_only links no banned unit: the check is not valid'; exit 1; }; if ocamlobjinfo %{dep:router_browser_check.bc} | grep -E \"$banned\" | grep -vxF \"$brr\"; then echo 'kilim.router.browser links a banned unit (design section 13)'; exit 1; fi")))

(rule
 (alias runtest)
 (action
  (system
   "if ocamlobjinfo %{dep:../../src/router/kilim_router.cma} %{dep:../../src/router/browser/kilim_router_browser.cma} | grep -E \"\t(CamlinternalFormat|Stdlib__(Printf|Format|Scanf|Hashtbl|Random|Fun|Printexc)|Str)$\"; then echo 'kilim.router or kilim.router.browser imports a banned interface (design section 13)'; exit 1; fi")))

