; The check of the code in the documentation (check.mjs): each tagged block of
; README.md, docs/loader.md and the doc comments of src/core/kilim.mli,
; src/testing/kilim_testing.mli and src/browser/kilim_browser.mli is the code
; of a file of the repository.

(rule
 (alias runtest)
 (deps
  check.mjs
  ../../README.md
  ../../docs/loader.md
  ../../src/core/kilim.mli
  ../../src/testing/kilim_testing.mli
  ../../src/browser/kilim_browser.mli
  (source_tree ../../examples)
  (source_tree ../doc))
 (action
  (run
   node
   check.mjs
   ../..
   README.md
   9
   docs/loader.md
   2
   src/core/kilim.mli
   7
   src/testing/kilim_testing.mli
   1
   src/browser/kilim_browser.mli
   1)))
