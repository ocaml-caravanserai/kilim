; The check of the code in the documentation (check.mjs): each tagged block of
; README.md, docs/loader.md, docs/index.mld and the doc comments of
; src/core/kilim.mli, src/testing/kilim_testing.mli,
; src/browser/kilim_browser.mli and the four browser libraries is the code of
; a file of the repository.

(rule
 (alias runtest)
 (deps
  check.mjs
  ../../README.md
  ../../docs/loader.md
  ../../docs/index.mld
  ../../src/core/kilim.mli
  ../../src/testing/kilim_testing.mli
  ../../src/browser/kilim_browser.mli
  ../../src/http/browser/kilim_http_browser.mli
  ../../src/router/browser/kilim_router_browser.mli
  ../../src/websocket/browser/kilim_websocket_browser.mli
  ../../src/storage/browser/kilim_storage_browser.mli
  (source_tree ../../examples)
  (source_tree ../doc)
  (env_var KILIM_REQUIRE_NODE))
 (action
  (run
   %{exe:../node/node_run.exe}
   check.mjs
   ../..
   README.md
   22
   docs/loader.md
   2
   docs/index.mld
   2
   src/core/kilim.mli
   8
   src/testing/kilim_testing.mli
   1
   src/browser/kilim_browser.mli
   1
   src/http/browser/kilim_http_browser.mli
   1
   src/router/browser/kilim_router_browser.mli
   1
   src/websocket/browser/kilim_websocket_browser.mli
   1
   src/storage/browser/kilim_storage_browser.mli
   1)))
