; The release profile (make test-release and make browsers): the bindings
; depend on the dead code elimination and on the JS expressions of the release
; build. Chrome runs W1 to W6 and WC, Firefox and WebKit run W4 to W6 and WC.
; The three browsers run the router page (R1 to R8 and W7), the http page
; (HT0 to HT9), the websocket page (WS0 to WS6) and the storage page (ST1 to
; ST3).

(rule
 (alias release)
 (enabled_if
  (= %{profile} release))
 (deps
  (alias pages)
  (env_var KILIM_CHROME)
  (env_var KILIM_REQUIRE_CHROME)
  (env_var KILIM_REQUIRE_NODE))
 (action
  (run
   %{exe:../node/node_run.exe}
   run.mjs
   test_web.bc.js
   test_web.bc.wasm.js
   test_fut.bc.js
   test_fut.bc.wasm.js
   test_http.bc.js
   test_http.bc.wasm.js
   test_websocket.bc.js
   test_websocket.bc.wasm.js
   test_storage.bc.js
   test_storage.bc.wasm.js
   test_csp.bc.js
   test_csp.bc.wasm.js
   test_router.bc.js
   test_router.bc.wasm.js)))

(rule
 (alias release_browsers)
 (enabled_if
  (= %{profile} release))
 (deps
  (alias pages)
  (env_var KILIM_PLAYWRIGHT)
  (env_var PLAYWRIGHT_BROWSERS_PATH)
  (env_var __EGL_VENDOR_LIBRARY_FILENAMES)
  (env_var KILIM_REQUIRE_PLAYWRIGHT)
  (env_var KILIM_REQUIRE_NODE))
