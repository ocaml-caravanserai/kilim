; The DOM tests in real headless browsers (design section 14), in the
; js_of_ocaml and wasm_of_ocaml builds. run.mjs drives the browser through the
; interface of browser.mjs, with node only: Chrome over the DevTools pipe
; (chrome.mjs) in the alias runtest, and Firefox and WebKit through Playwright
; (playwright.mjs) in the alias browsers (`make browsers`). The tools of
; Playwright come from the dev shell `browsers` of flake.nix. With no Chrome or
; no Playwright, run.mjs writes "SKIP: no Chrome" or "SKIP: no Playwright", but
; CI sets KILIM_REQUIRE_CHROME=1 and KILIM_REQUIRE_PLAYWRIGHT=1 and fails. One
; rule for each browser: dune runs them at the same time, and a failure has the
; name of its browser.

(executables
 (names
  smoke
  test_dom
  test_web
  test_fut
  test_csp
  test_router
  test_http
  test_websocket
  test_storage)
 (modes js wasm)
 (libraries
  kilim
  kilim.browser
  kilim.web
  kilim.router
  kilim.router.browser
  kilim.http
  kilim.http.browser
  kilim.websocket
  kilim.websocket.browser
  kilim.storage
  kilim.storage.browser
  brr
  url_corpus))

; The files of each rule: the runner, the pages and the ES module of the
; tests W5, W6 and WC. test_http (HT0 to HT9) uses the /http endpoints of
; run.mjs, test_websocket (WS0 to WS6) the /ws endpoints of run.mjs with the
; server of examples/ws.mjs, and test_storage (ST1 to ST3) a shim of the
; storage errors.

(alias
 (name pages)
 (deps
  run.mjs
  browser.mjs
  chrome.mjs
  playwright.mjs
  mod/web_mod.mjs
  ../../examples/ws.mjs
  smoke.bc.js
  smoke.bc.wasm.js
  (glob_files smoke.bc.wasm.assets/*.wasm)
  test_dom.bc.js
  test_dom.bc.wasm.js
  (glob_files test_dom.bc.wasm.assets/*.wasm)
  test_web.bc.js
  test_web.bc.wasm.js
  (glob_files test_web.bc.wasm.assets/*.wasm)
  test_fut.bc.js
  test_fut.bc.wasm.js
  (glob_files test_fut.bc.wasm.assets/*.wasm)
  test_csp.bc.js
  test_csp.bc.wasm.js
  (glob_files test_csp.bc.wasm.assets/*.wasm)
  test_router.bc.js
  test_router.bc.wasm.js
  (glob_files test_router.bc.wasm.assets/*.wasm)
  test_http.bc.js
  test_http.bc.wasm.js
  (glob_files test_http.bc.wasm.assets/*.wasm)
  test_websocket.bc.js
  test_websocket.bc.wasm.js
  (glob_files test_websocket.bc.wasm.assets/*.wasm)
  test_storage.bc.js
  test_storage.bc.wasm.js
  (glob_files test_storage.bc.wasm.assets/*.wasm)))

; The dev profile. Chrome in the alias runtest, Firefox and WebKit in the alias
; browsers. --no-wasm: the js_of_ocaml pages in a browser with no WebAssembly:
; Chrome with no JIT (as Chrome with "JavaScript optimization" off), and
; Firefox with the preference javascript.options.wasm = false. The apps start
; and work. WebKit has no such switch. run.mjs gives the pages test_csp (WC) a
; CSP with no 'unsafe-eval'.

(rule
 (alias runtest)
 (deps
  (alias pages)
  (env_var KILIM_CHROME)
  (env_var KILIM_REQUIRE_CHROME)
  (env_var KILIM_REQUIRE_NODE))
 (action
  (run
   %{exe:../node/node_run.exe}
   run.mjs
   smoke.bc.js
   smoke.bc.wasm.js
   test_dom.bc.js
   test_dom.bc.wasm.js
   test_web.bc.js
   test_web.bc.wasm.js
   test_fut.bc.js
   test_fut.bc.wasm.js
   test_http.bc.js
   test_http.bc.wasm.js
   test_websocket.bc.js
   test_websocket.bc.wasm.js
   test_storage.bc.js
   test_storage.bc.wasm.js
   test_csp.bc.js
   test_csp.bc.wasm.js
   test_router.bc.js
   test_router.bc.wasm.js)))

(rule
 (alias runtest)
 (deps
  (alias pages)
  (env_var KILIM_CHROME)
  (env_var KILIM_REQUIRE_CHROME)
  (env_var KILIM_REQUIRE_NODE))
 (action
  (run
   %{exe:../node/node_run.exe}
   run.mjs
   --no-wasm
   smoke.bc.js
   test_dom.bc.js
   test_web.bc.js
   test_fut.bc.js
   test_http.bc.js
   test_websocket.bc.js
   test_storage.bc.js
   test_csp.bc.js
   test_router.bc.js)))

(rule
 (alias browsers)
 (deps
  (alias pages)
  (env_var KILIM_PLAYWRIGHT)
  (env_var PLAYWRIGHT_BROWSERS_PATH)
  (env_var __EGL_VENDOR_LIBRARY_FILENAMES)
  (env_var KILIM_REQUIRE_PLAYWRIGHT)
  (env_var KILIM_REQUIRE_NODE))
 (action
  (run
   %{exe:../node/node_run.exe}
   run.mjs
   --browser
   firefox
   smoke.bc.js
   smoke.bc.wasm.js
   test_dom.bc.js
   test_dom.bc.wasm.js
   test_web.bc.js
   test_web.bc.wasm.js
   test_fut.bc.js
   test_fut.bc.wasm.js
   test_http.bc.js
   test_http.bc.wasm.js
   test_websocket.bc.js
   test_websocket.bc.wasm.js
   test_storage.bc.js
   test_storage.bc.wasm.js
   test_csp.bc.js
   test_csp.bc.wasm.js
   test_router.bc.js
   test_router.bc.wasm.js)))

