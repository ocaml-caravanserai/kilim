; The browser test of the examples (docs/design.html, "Testing"): run.mjs
; drives the page of each example with trusted input (the commands of
; DevTools, which Playwright translates), in the wasm_of_ocaml and the
; js_of_ocaml builds: Chrome in the alias runtest, Firefox and WebKit in the
; alias browsers (`make browsers`). In the dev profile, it serves the dev page
; (index.html) with examples/serve.mjs. In the release profile (`make
; test-release`, `make browsers`), it runs `kilim dist` of docs/loader.md on
; the release builds, and serves the output at /static/ with the CSP of
; docs/loader.md. The browser with no WebAssembly is real in Chrome (no JIT)
; and Firefox (a preference), and simulated in WebKit (a script deletes
; WebAssembly before the page). The differences of the browsers are in the
; table `browsers` of run.mjs. With no Chrome or no Playwright, run.mjs writes
; "SKIP: no Chrome" or "SKIP: no Playwright", but CI sets
; KILIM_REQUIRE_CHROME=1 and KILIM_REQUIRE_PLAYWRIGHT=1 and fails.

; The files of each rule: the runner, its browser interface, the server,
; kilim and the builds of the examples.

(alias
 (name files)
 (deps
  run.mjs
  ../dom/browser.mjs
  ../dom/chrome.mjs
  ../dom/playwright.mjs
  ../../examples/serve.mjs
  %{bin:kilim}
  ../../examples/counter/index.html
  ../../examples/counter/page.html
  ../../examples/counter/main.bc.js
  ../../examples/counter/main.bc.wasm.js
  (glob_files ../../examples/counter/main.bc.wasm.assets/*)
  ../../examples/todo/index.html
  ../../examples/todo/page.html
  ../../examples/todo/main.bc.js
  ../../examples/todo/main.bc.wasm.js
  (glob_files ../../examples/todo/main.bc.wasm.assets/*)
  ../../examples/components/index.html
  ../../examples/components/page.html
  ../../examples/components/main.bc.js
  ../../examples/components/main.bc.wasm.js
  (glob_files ../../examples/components/main.bc.wasm.assets/*)
  ../../examples/search/index.html
  ../../examples/search/page.html
  ../../examples/search/main.bc.js
  ../../examples/search/main.bc.wasm.js
  (glob_files ../../examples/search/main.bc.wasm.assets/*)))

(rule
 (alias runtest)
 (deps
  (alias files)
  (env_var KILIM_CHROME)
  (env_var KILIM_REQUIRE_CHROME))
 (action
  (run
   node
   run.mjs
   --kilim
   %{bin:kilim}
   --profile
   %{profile}
   ../../examples/counter
   ../../examples/todo
   ../../examples/components
   ../../examples/search)))

(rule
 (alias browsers)
 (deps
  (alias files)
  (env_var KILIM_PLAYWRIGHT)
  (env_var PLAYWRIGHT_BROWSERS_PATH)
  (env_var __EGL_VENDOR_LIBRARY_FILENAMES)
  (env_var KILIM_REQUIRE_PLAYWRIGHT))
 (action
  (run
   node
   run.mjs
   --kilim
   %{bin:kilim}
   --profile
   %{profile}
   --browser
   firefox
   ../../examples/counter
   ../../examples/todo
   ../../examples/components
   ../../examples/search)))

(rule
 (alias browsers)
 (deps
  (alias files)
  (env_var KILIM_PLAYWRIGHT)
  (env_var PLAYWRIGHT_BROWSERS_PATH)
  (env_var __EGL_VENDOR_LIBRARY_FILENAMES)
  (env_var KILIM_REQUIRE_PLAYWRIGHT))
 (action
  (run
   node
   run.mjs
   --kilim
   %{bin:kilim}
   --profile
   %{profile}
   --browser
   webkit
   ../../examples/counter
   ../../examples/todo
   ../../examples/components
   ../../examples/search)))
