; The test library (design section 14): a strict fake DOM for the diff tests,
; and a host with a virtual clock. It uses only the standard library and
; kilim, thus it builds also for js_of_ocaml and wasm_of_ocaml (test/cross).

(library
 (name kilim_testing)
 (public_name kilim.testing)
 (libraries kilim)
 (instrumentation
  (backend ppx_windtrap.coverage))
 (instrumentation
  (backend ppx_windtrap.mutate)))
